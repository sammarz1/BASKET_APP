# Object Storage Configuration (Local MinIO defaults)
# When deploying to Production (AWS S3), set S3_ENDPOINT_URL to empty string or leave unset,
# set S3_USE_SSL=true, and supply production AWS credentials / IAM.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=bronze
S3_REGION=us-east-1
S3_USE_SSL=false

# HTTP client (extractors)
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=5
HTTP_BACKOFF_FACTOR=1.0
HTTP_MIN_INTERVAL_SECONDS=1.0
# Leave unset to use the requests default UA. Spoofed browser UAs get 403 from some WAFs (ESPN).
# HTTP_USER_AGENT=
