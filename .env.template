# Object Storage Configuration (Local MinIO defaults)
# When deploying to Production (AWS S3), set S3_ENDPOINT_URL to empty string or leave unset,
# set S3_USE_SSL=true, and supply production AWS credentials / IAM.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=bronze
S3_REGION=us-east-1
S3_USE_SSL=false

# Minimum delay between consecutive HTTP requests (extractors)
HTTP_MIN_INTERVAL_SECONDS=1.0
